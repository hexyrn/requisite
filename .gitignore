# E2E generated artifacts (item 29) - regenerated per run by apps/api/scripts/e2e-seed.ts
e2e/fixtures/seed-output.json
e2e/test-results/
e2e/playwright-report/

# Windows release build staging (P3 item 3) - third-party artifacts (the
# ~380MB PostgreSQL binaries zip and its extracted contents, the bundled
# Node.js runtime zip) and build output. NEVER commit these - see
# docs/WINDOWS_INSTALLER_DESIGN.md's "Reproducible build staging" section
# for the deterministic, documented staging locations these represent.
.build-cache/
dist-release/
# WiX's own local extension cache created by `wix extension add`/
# `dotnet tool restore` against the committed .config/dotnet-tools.json -
# machine-local, not something to commit (re-created by `dotnet tool
# restore` + `wix extension add ... /4.0.6` per docs/WINDOWS_ACCEPTANCE_PREP.md).
.wix/


# vendor licence signing keys (private key must never be committed)
licence-keys/
licence-private.pem
*.licence
.sandbox-ca.crt
*.sandbox
