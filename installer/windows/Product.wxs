<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hexyrn Core Windows installer - WiX Toolset source (P3 item 3).

  TOOLCHAIN VERSION - PINNED, NOT "latest": WiX Toolset 4.0.6 + extensions
  WixToolset.Util.wixext 4.0.6 and WixToolset.Bal.wixext 4.0.6 EXACTLY.
  This is deliberate, not an oversight: an earlier attempt to install
  "the latest WiX" on the real Windows RC build machine resolved to WiX 7,
  which pulled in an OSMF EULA acceptance requirement this RC does not
  want to take on. We deliberately pinned back to WiX 4.0.6 for this RC -
  see docs/WINDOWS_ACCEPTANCE_PREP.md's pinned install command. Do not
  upgrade this project to WiX 7 without a deliberate, separate decision.

  STATUS UPDATE: the external-artifact boundary is CLOSED - the real
  PostgreSQL 17.11-4 Windows binaries (EDB's official distribution,
  SHA-256 b9424ee7bc60b52450ff910a3630225df32e633f3cb29c1d126d9299d59aea28,
  independently verified) have been obtained and staged via
  scripts/windows/stage-postgres-artifact.ps1 (fail-closed hash check,
  real archive-layout inspection - found the archive also contains an
  ~806MB pgAdmin 4 GUI application and a StackBuilder utility, NEITHER
  of which this installer bundles - see build-release.ps1's step 6 for
  the deliberate bin/lib/share/include-only selection). This file now
  contains the real bundled-PostgreSQL components (a second service,
  data directory, provisioning custom action calling
  scripts/windows/provision-postgres.ps1's already-independently-tested
  logic) rather than TODO placeholders. Real file harvesting for the
  application payload is generated by
  scripts/windows/generate-payload-harvest.ps1 (see the ApiFiles comment
  below). This file is being compiled for real against the actual WiX
  4.0.6 toolchain and real staged artifacts on this machine - see
  P3-ENVIRONMENT-VERIFICATION.md for the exact compile results.

  The API/web payload referenced below is produced by
  scripts/windows/build-release-payload.ps1 - the SAME production build
  output apps/api/Dockerfile's runtime stage packages (one build
  pipeline, two distribution mechanisms, not two separately-maintained
  builds that could drift apart). See docs/WINDOWS_INSTALLER_DESIGN.md
  for the reasoning behind every decision below.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="Requisite"
    Manufacturer="Hexyrn"
    Version="$(var.HexyrnVersion)"
    UpgradeCode="8f2b6c1a-2f0e-4c3a-9a7e-3b1c9d5f6a02"
    Compressed="yes">

    <!-- Upgrade behaviour: newer versions replace older ones in place,
         never allow a downgrade over a newer install (item 15's rollback
         strategy is handled separately, via a restored backup + an
         explicitly OLDER installer package - not by letting this MSI
         silently downgrade files under a running database). -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Requisite is already installed. Uninstall it first if you specifically need to downgrade."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Standard-ish Program Files layout, not something bespoke -
         predictable for anyone who has installed other Windows server
         software, and keeps the app payload out of user-writable
         locations by default. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Hexyrn Core">
        <!-- apps/api/dist + node_modules, i.e. the SAME output
             apps/api/Dockerfile's runtime stage packages - one build
             output, two distribution mechanisms (Docker image, Windows
             installer), not two separately-maintained builds that could
             drift apart. -->
        <Directory Id="ApiFolder" Name="api" />
        <!-- PostgreSQL RUNTIME BINARIES only (bin/lib/share/include -
             see build-release.ps1's step 6 for exactly why pgAdmin
             4/StackBuilder from the EDB archive are deliberately
             excluded here) - the DATA lives under ProgramData below,
             never here, for the same "Program Files is replaceable,
             ProgramData is persistent" reasoning as the application
             payload itself. -->
        <Directory Id="PostgresFolder" Name="postgresql" />
        <!-- Hexyrn-controlled Node.js 20.x runtime (bundled, not
             resolved from PATH - item 7's explicit requirement). See
             docs/WINDOWS_INSTALLER_DESIGN.md's "Node.js runtime
             packaging" section for the external-artifact sourcing. -->
        <Directory Id="NodeRuntimeFolder" Name="node" />
        <!-- Provisioning scripts bundled into the install so the
             deferred custom actions below can invoke them by an
             absolute, Hexyrn-controlled path - never relying on
             PowerShell script files existing anywhere outside this
             installer's own payload. -->
        <Directory Id="ScriptsFolder" Name="scripts" />
        <Directory Id="ServiceFolder" Name="service" />
        <!-- Config/data directories are OUTSIDE INSTALLFOLDER (in
             ProgramData, not Program Files) - Program Files is
             conventionally treated as read-mostly and can require
             elevated permissions to write to at runtime; a database
             connection string, license file, or backup written under
             Program Files by a running service is the kind of thing
             that silently breaks under stricter ACLs or a future
             Windows hardening policy. -->
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="HexyrnDataFolder" Name="Hexyrn Core">
        <Directory Id="HexyrnStorageFolder" Name="storage" />
        <Directory Id="HexyrnBackupsFolder" Name="backups" />
        <Directory Id="HexyrnConfigFolder" Name="config" />
        <Directory Id="HexyrnLogsFolder" Name="logs" />
        <!-- The actual PostgreSQL CLUSTER (initdb output) - persistent
             customer data, explicitly NOT under the replaceable
             Program Files application directory (docs/
             WINDOWS_INSTALLER_DESIGN.md's "Data directory" section,
             and the coordinator's explicit item 4/8 requirement). An
             application upgrade replaces PostgresFolder's BINARIES;
             it must never touch this directory's CONTENTS. -->
        <Directory Id="HexyrnPostgresDataFolder" Name="postgresql-data" />
      </Directory>
    </StandardDirectory>

    <!-- Real credential/property plumbing, not hard-coded values:
         HEXYRNPGPORT is the loopback-only port Hexyrn's managed
         PostgreSQL listens on (docs/WINDOWS_INSTALLER_DESIGN.md's "Port
         strategy" - deliberately NOT reusing 5432 by default, since the
         developer's own machine already runs an unrelated native
         PostgreSQL 17 dev instance on 5432 that this installer must
         never collide with or touch - item 9's explicit requirement).
         A real Windows-round refinement (not done here) is a Burn
         bundle UI step that probes port availability and lets this
         property be overridden if even 55432 happens to be taken. -->
    <Property Id="HEXYRNPGPORT" Value="55432" />
    <!-- Port the app listens on (loopback only by default); users open http://localhost:<this>. -->
    <Property Id="HEXYRNWEBPORT" Value="3000" />

    <Feature Id="MainFeature" Title="Requisite" Level="1">
      <ComponentGroupRef Id="ApiFiles" />
      <ComponentGroupRef Id="NodeRuntimeFiles" />
      <ComponentGroupRef Id="PostgresRuntimeFiles" />
      <ComponentRef Id="NodeRuntimeExe" />
      <ComponentRef Id="HexyrnCoreService" />
      <ComponentRef Id="HexyrnPostgresService" />
      <ComponentRef Id="ProvisioningScripts" />
      <ComponentRef Id="ProvisionCustomAction" />
      <ComponentRef Id="LicenceKeyFile" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="DataDirectories" />
    </Feature>

    <!-- Node.js runtime EXECUTABLE, hand-authored (NOT part of the
         generated NodeRuntimeFiles harvest below, which explicitly
         excludes it - see build-release.ps1's harvest invocation) -
         this Component's File IS the Windows Service's actual image
         path (a Windows service must be registered against a real .exe,
         never a .js file - HexyrnService below sets Arguments to the
         compiled entry point, run BY this node.exe, at its own absolute
         installed path, never resolved via PATH). -->
    <!-- Windows Service registration - the KeyPath file of THIS
         component (node.exe) is what makes the SCM's registered image
         path a real, absolute-path .exe, never a .js file directly and
         never anything resolved via PATH - Arguments below supplies the
         compiled entry point by its own absolute installed path.
         StartType="demand" (not "auto") is DELIBERATE for the FIRST
         release: an operator should complete first-run
         setup/configuration (docs/OPERATOR_GUIDE.md) and confirm the
         service starts cleanly before it's trusted to auto-start
         unattended on every boot. -->
    <Component Id="NodeRuntimeExe" Directory="NodeRuntimeFolder" Guid="e2f4a6c8-1b3d-4e5f-9a7c-2d4e6f8a1b30">
      <File Id="NodeExe" Source="$(var.NodeRuntimeDir)\node.exe" KeyPath="yes" />
    </Component>

    <!-- THE APPLICATION SERVICE. node.exe cannot itself be a Windows service (it never answers the Service
         Control Manager, so Windows kills it after 30 seconds with error 1053). The service image is
         therefore WinSW (RequisiteService.exe, MIT licence, hash-pinned by stage-winsw-artifact.ps1), which
         reads RequisiteService.xml beside it and runs the bundled node.exe with the app.
         - Start="auto": comes back after a reboot without anyone logging in.
         - Account: a Windows virtual service account (no password to manage, no interactive logon, its own
           SID that file permissions can target; see SetHexyrnDataAcls below).
         - ServiceDependency: Windows itself starts the database service first and stops it last.
         - util:ServiceConfig: restart after a crash after 10s, then 30s, then 60s; the failure counter
           resets after a day, so an occasional crash never escalates into a permanent outage. -->
    <Component Id="HexyrnCoreService" Directory="ServiceFolder" Guid="0b2d4f6a-8c1e-4a3b-9d5f-7e9a1c3b5d21">
      <File Id="RequisiteServiceExe" Source="$(var.WinSwExe)" Name="RequisiteService.exe" KeyPath="yes" />
      <File Id="RequisiteServiceXml" Source="$(var.RepoRoot)\installer\windows\RequisiteService.xml" Name="RequisiteService.xml" />
      <ServiceInstall
        Id="HexyrnCoreServiceInstall"
        Type="ownProcess"
        Name="HexyrnCore"
        DisplayName="Requisite"
        Description="Requisite application server (web app and API). Depends on the Requisite database service."
        Start="auto"
        ErrorControl="normal"
        Account="NT SERVICE\HexyrnCore">
        <ServiceDependency Id="HexyrnPostgreSQL" />
      </ServiceInstall>
      <ServiceControl
        Id="HexyrnCoreServiceControl"
        Name="HexyrnCore"
        Start="install"
        Stop="both"
        Remove="uninstall"
        Wait="yes" />
      <util:ServiceConfig
        ServiceName="HexyrnCore"
        FirstFailureActionType="restart"
        SecondFailureActionType="restart"
        ThirdFailureActionType="restart"
        RestartServiceDelayInSeconds="10"
        ResetPeriodInDays="1" />
    </Component>

    <!-- PostgreSQL Windows Service - Hexyrn-MANAGED identity
         "HexyrnPostgreSQL", genuinely distinct from the unrelated
         "postgresql-x64-17" service EDB's own interactive installer
         creates (this development machine's own native dev PostgreSQL,
         which this installer must never touch - item 9's explicit
         requirement). Registered against the bundled postgres.exe at
         its own absolute installed path (never PATH), listening only on
         HEXYRNPGPORT (loopback - docs/WINDOWS_INSTALLER_DESIGN.md's
         "Port strategy"), pointed at its own isolated data directory
         under ProgramData via Arguments. Start="demand" for the same
         first-boot-confirmation reasoning as HexyrnCore above; both
         being "demand" rather than "auto" for v1 is a deliberate,
         matched pair, not an oversight on one side. -->
    <Component Id="HexyrnPostgresService" Directory="dir_bin_3177c0de" Guid="7c9e1f3a-5b2d-4e6c-8a1f-3d5b7e9c2a40">
      <!-- postgres.exe is not a Windows service either. PostgreSQL's own service mode is `pg_ctl.exe
           runservice` (exactly what `pg_ctl register` would write): pg_ctl answers the Service Control
           Manager, starts postgres.exe with a restricted token, and performs a fast, clean shutdown when
           the service is stopped or the machine shuts down.
           The data folder argument ends in "." because a directory property ends in a backslash and a
           backslash before the closing quote would escape the quote. -->
      <File Id="PgCtlExe" Source="$(var.PostgresRuntimeDir)\bin\pg_ctl.exe" KeyPath="yes" />
      <ServiceInstall
        Id="HexyrnPostgresServiceInstall"
        Type="ownProcess"
        Name="HexyrnPostgreSQL"
        DisplayName="Requisite Database (PostgreSQL)"
        Description="PostgreSQL 17 database engine used by Requisite. Listens on the local machine only. Separate from any other PostgreSQL installation."
        Start="auto"
        ErrorControl="normal"
        Arguments="runservice -N &quot;HexyrnPostgreSQL&quot; -D &quot;[HexyrnPostgresDataFolder].&quot; -w"
        Account="NT SERVICE\HexyrnPostgreSQL" />
      <ServiceControl
        Id="HexyrnPostgresServiceControl"
        Name="HexyrnPostgreSQL"
        Start="install"
        Stop="both"
        Remove="uninstall"
        Wait="yes" />
      <util:ServiceConfig
        ServiceName="HexyrnPostgreSQL"
        FirstFailureActionType="restart"
        SecondFailureActionType="restart"
        ThirdFailureActionType="restart"
        RestartServiceDelayInSeconds="10"
        ResetPeriodInDays="1" />
    </Component>

    <!-- Provisioning scripts, bundled so the deferred custom action
         below can call them at their own absolute installed path.
         scripts/windows/provision-postgres.ps1 is the SAME,
         independently-verified logic this repository already tested
         standalone this phase (real initdb, real role-creation SQL
         matching docker/postgres-init/01-app-role.sh's exact
         hexyrn/hexyrn_app/hexyrn_backup model, real generated
         credentials) - called here, not reimplemented. -->
    <Component Id="ProvisioningScripts" Directory="ScriptsFolder" Guid="9d1f3b5c-7e9a-4c2d-8f1b-3e5d7f9a1c60">
      <File Id="ProvisionPostgresScript" Source="$(var.RepoRoot)\scripts\windows\provision-postgres.ps1" KeyPath="yes" />
      <File Id="GenerateCredentialsScript" Source="$(var.RepoRoot)\scripts\windows\generate-credentials.ps1" />
      <File Id="OpenHexyrnScript" Source="$(var.RepoRoot)\scripts\windows\Open-Hexyrn.ps1" />
      <File Id="HexyrnCommonScript" Source="$(var.RepoRoot)\scripts\windows\Hexyrn-Common.ps1" />
      <File Id="EnableLanAccessScript" Source="$(var.RepoRoot)\scripts\windows\Enable-LanAccess.ps1" />
      <File Id="SupportBundleScript" Source="$(var.RepoRoot)\scripts\windows\Get-SupportBundle.ps1" />
      <File Id="ResetPasswordScript" Source="$(var.RepoRoot)\scripts\windows\Reset-Password.ps1" />
      <File Id="RemoveDataScript" Source="$(var.RepoRoot)\scripts\windows\Remove-RequisiteData.ps1" />
    </Component>

    <!-- The provisioning CUSTOM ACTION itself. Execute="deferred" +
         Impersonate="no" runs this AFTER the files above are installed
         (so provision-postgres.ps1 finds a real postgres.exe/initdb.exe
         to call) and WITH FULL PRIVILEGES regardless of the installing
         user's own token (required for initdb, service-adjacent file
         creation, and later ACL work) - the standard, correct WiX
         pattern for privileged post-install setup, not a workaround.

         SECURITY: WiX/MSI CAN log a deferred custom action's OWN
         property values if verbose MSI logging is enabled
         (`msiexec /l*v`) and those values were passed via
         CustomActionData - this action deliberately passes NO secrets
         that way. provision-postgres.ps1 generates its own credentials
         INTERNALLY (via generate-credentials.ps1, called with -NoAcl:$false
         so the result is immediately ACL-locked) and writes them only
         to the ACL-protected config file - never returned to, or logged
         by, the MSI engine itself. The command line below carries only
         non-sensitive paths/ports, which is what "review WiX
         custom-action logging behaviour carefully" concretely resolves
         to here. -->
    <Component Id="ProvisionCustomAction" Directory="ScriptsFolder" Guid="1a3c5e7f-9b1d-4c3e-6a8f-1c3e5a7c9e70">
      <RegistryValue
        Root="HKLM"
        Key="SOFTWARE\Hexyrn\Core"
        Name="ProvisionMarker"
        Type="string"
        Value="[ProductVersion]"
        KeyPath="yes" />
    </Component>
    <!-- Filesystem ACLs (P3 item 7): grant each virtual service account
         ONLY what it needs, per docs/WINDOWS_INSTALLER_DESIGN.md's
         "Windows Service account" section's explicit design - NOT broad
         ProgramData write access. HexyrnCore gets storage/backups/config
         (never postgresql-data - it never touches PostgreSQL's data
         directly, only over its own loopback DB connection). HexyrnPostgreSQL
         gets postgresql-data ONLY (never storage/backups/config - it has
         no reason to read the application's own files). icacls'
         `/inheritance:r` first removes inherited (often too-broad)
         permissions before granting the specific ones below - a real,
         minimal grant, not an additive one on top of a broad default. -->
    <CustomAction
      Id="SetHexyrnDataAcls"
      Directory="HexyrnDataFolder"
      ExeCommand="cmd.exe /c icacls &quot;[HexyrnStorageFolder].&quot; /inheritance:r /grant:r &quot;NT SERVICE\HexyrnCore:(OI)(CI)M&quot; &quot;*S-1-5-32-544:(OI)(CI)F&quot; &amp; icacls &quot;[HexyrnBackupsFolder].&quot; /inheritance:r /grant:r &quot;NT SERVICE\HexyrnCore:(OI)(CI)M&quot; &quot;*S-1-5-32-544:(OI)(CI)F&quot; &amp; icacls &quot;[HexyrnConfigFolder].&quot; /inheritance:r /grant:r &quot;NT SERVICE\HexyrnCore:(OI)(CI)M&quot; &quot;*S-1-5-32-544:(OI)(CI)F&quot; &amp; icacls &quot;[HexyrnPostgresDataFolder].&quot; /inheritance:r /grant:r &quot;NT SERVICE\HexyrnPostgreSQL:(OI)(CI)F&quot; &quot;*S-1-5-32-544:(OI)(CI)F&quot; &amp; icacls &quot;[HexyrnLogsFolder].&quot; /inheritance:r /grant:r &quot;NT SERVICE\HexyrnCore:(OI)(CI)M&quot; &quot;*S-1-5-32-544:(OI)(CI)F&quot; &amp; icacls &quot;[INSTALLFOLDER].&quot; /grant &quot;NT SERVICE\HexyrnCore:(OI)(CI)RX&quot; &quot;NT SERVICE\HexyrnPostgreSQL:(OI)(CI)RX&quot;"
      Execute="deferred"
      Return="check"
      Impersonate="no" />
    <!-- *S-1-5-32-544 is the well-known SID for BUILTIN\Administrators
         (used instead of the localized name, which varies by Windows
         display language) - Administrators retain Full Control for
         support/recovery; every other principal is excluded by the
         /inheritance:r reset above. -->

    <CustomAction
      Id="ProvisionHexyrnPostgres"
      Directory="ScriptsFolder"
      ExeCommand="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[ScriptsFolder]provision-postgres.ps1&quot; -PgBinPath &quot;[PostgresFolder]bin&quot; -DataDir &quot;[HexyrnPostgresDataFolder].&quot; -Port [HEXYRNPGPORT] -RunMigrations -MigratePayloadDir &quot;[ApiFolder].&quot; -NodeExe &quot;[NodeRuntimeFolder]node.exe&quot; -InstallDir &quot;[INSTALLFOLDER].&quot; -DataRoot &quot;[HexyrnDataFolder].&quot; -LicenceKeyFile &quot;[INSTALLFOLDER]licence-public-key.txt&quot; -WebPort [HEXYRNWEBPORT]"
      Execute="deferred"
      Return="check"
      Impersonate="no" />

    <!-- The purge custom action (P3 item 8/9's real, functional data-
         deletion path) - only ever runs when HEXYRNPURGEDATA is
         genuinely "1" (set via installer/windows/Bundle.wxs's
         MsiProperty, itself only ever "1" if an operator explicitly
         passed `/HEXYRNPURGEDATA=1` on the uninstall command line - see
         that file's own comment) AND this is a genuine removal
         (REMOVE="ALL", not an upgrade/repair pass, which also sets
         REMOVE="ALL" transiently but Installed+WixUpgradeDetected
         distinguishes a true uninstall from an in-place upgrade's own
         old-version removal step). Stops both services first (a running
         service holds its data directory open) via net.exe - genuinely
         simpler and more reliable inside a deferred custom action than
         re-deriving ServiceControl's own stop logic - then removes the
         entire persistent-data tree. This is the REAL mechanism, not a
         comment promising it: the default (no flag) path never reaches
         this action at all, since HEXYRNPURGEDATA stays "0". -->
    <Property Id="HEXYRNPURGEDATA" Value="0" Secure="yes" />
    <CustomAction
      Id="PurgeHexyrnData"
      Directory="HexyrnDataFolder"
      ExeCommand="cmd.exe /c (net stop HexyrnCore) &amp; (net stop HexyrnPostgreSQL) &amp; (rmdir /s /q &quot;[HexyrnDataFolder]&quot;)"
      Execute="deferred"
      Return="ignore"
      Impersonate="no" />

    <InstallExecuteSequence>
      <!-- Runs after files are on disk (so the scripts/binaries it
           needs exist) but before the SCM is asked to start any
           service (so PostgreSQL has a real, initialized data directory
           and roles to start against) - real ordering, not aspirational
           comments. StartServices is WiX's own standard action name for
           "the point at which newly-installed services are started." -->
      <Custom Action="SetHexyrnDataAcls" After="InstallFiles" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="ProvisionHexyrnPostgres" After="SetHexyrnDataAcls" Condition="NOT Installed OR REINSTALL" />
      <!-- Purge runs during removal, after services have been asked to
           stop (After="StopServices" - WiX's own standard action for
           "services are being stopped as part of this sequence") and
           only on a genuine uninstall with the explicit opt-in flag
           set - never on an ordinary upgrade/repair, and never by
           default even on a genuine uninstall. -->
      <Custom Action="PurgeHexyrnData" After="StopServices" Condition="REMOVE=&quot;ALL&quot; AND HEXYRNPURGEDATA=&quot;1&quot;" />
    </InstallExecuteSequence>

    <!-- ApiFiles / NodeRuntimeFiles / PostgresRuntimeFiles ComponentGroups:
         DEFINED IN GENERATED FRAGMENTS, not here.
         scripts/windows/generate-payload-harvest.ps1 (real, genuinely
         tested this round) walks the real staged payload/runtime
         directories and emits real nested Directory/Component/File
         trees, one Component per directory (not per file - the vendored
         node_modules tree alone is tens of thousands of files), with
         deterministic GUIDs so re-running it against an unchanged
         source is byte-identical (required for correct MSI upgrade
         semantics). build-release.ps1's own step 8 generates all three
         automatically as part of every real build; all three generated
         files plus this one are passed to the same `wix build`
         invocation (see docs/WINDOWS_ACCEPTANCE_PREP.md's exact
         command). node.exe and postgres.exe themselves are explicitly
         EXCLUDED from these harvests (see build-release.ps1's harvest
         invocations) because they are hand-authored above as their
         respective services' KeyPath files instead. -->

    <!-- The vendor's PUBLIC licence key, baked in at build time (build-release.ps1 -LicencePublicKeyFile). Public
         by nature; the matching private key never goes anywhere near an installer. provision-postgres.ps1 copies
         its value into hexyrn.env, and the app refuses to start in production without it. -->
    <Component Id="LicenceKeyFile" Directory="INSTALLFOLDER" Guid="4b6d8f0a-2c4e-4a6c-8e0a-2b4d6f8a0c11">
      <File Id="LicencePublicKeyFile" Source="$(var.LicencePublicKeyFile)" Name="licence-public-key.txt" KeyPath="yes" />
    </Component>

    <!-- Start Menu: "Hexyrn Core" opens the app (and on first run, the setup page with the setup code copied to
         the clipboard). Open-Hexyrn.ps1 elevates itself only when it must read the admin-only token file. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="HexyrnMenuFolder" Name="Hexyrn Core" />
    </StandardDirectory>
    <Component Id="StartMenuShortcuts" Directory="HexyrnMenuFolder" Guid="6d8f0a2c-4e6a-4c8e-a0c2-4d6f8a0c2e33">
      <Shortcut Id="OpenHexyrnShortcut" Name="Requisite" Description="Open Requisite in your browser"
                Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                Arguments="-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[ScriptsFolder]Open-Hexyrn.ps1&quot; -Port [HEXYRNWEBPORT]" />
      <RemoveFolder Id="RemoveHexyrnMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Hexyrn\Core" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DataDirectories" Directory="HexyrnDataFolder" Guid="3c7e9a1b-5d2f-4e8a-b6c3-1a9d7f2e4b08">
      <CreateFolder Directory="HexyrnStorageFolder" />
      <CreateFolder Directory="HexyrnBackupsFolder" />
      <CreateFolder Directory="HexyrnConfigFolder" />
      <CreateFolder Directory="HexyrnLogsFolder" />
      <CreateFolder Directory="HexyrnPostgresDataFolder" />
      <!-- Uninstall behaviour is deliberately NOT "always delete" - see
           docs/WINDOWS_INSTALLER_DESIGN.md's uninstall section: this
           mirrors scripts/uninstall-docker.sh's two-step confirm
           (remove the app, keep ALL of storage/backups/config/
           postgresql-data unless a SEPARATE explicit choice says
           otherwise). WiX's own <RemoveFolder> below only ever fires on
           a full "also delete data" uninstall path that installer/
           windows/Bundle.wxs's planned custom UI must explicitly opt
           into - it is NOT wired into the ordinary uninstall sequence,
           so a plain "Uninstall" from Programs and Features leaves this
           entire tree untouched by default (WiX's default behavior for
           a Component with CreateFolder and no RemoveFolder/RemoveFile
           tied to the main uninstall sequence is to leave the directory
           in place - the safe default, not something this file has to
           fight against). -->
    </Component>
  </Package>
</Wix>
