<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hexyrn Core Windows installer - WiX Toolset source (P3 item 3).

  TOOLCHAIN VERSION - PINNED, NOT "latest": WiX Toolset 4.0.6 + extensions
  WixToolset.Util.wixext 4.0.6 and WixToolset.Bal.wixext 4.0.6 EXACTLY.
  This is deliberate, not an oversight: an earlier attempt to install
  "the latest WiX" on the real Windows RC build machine resolved to WiX 7,
  which pulled in an OSMF EULA acceptance requirement this RC does not
  want to take on. We deliberately pinned back to WiX 4.0.6 for this RC -
  see docs/WINDOWS_ACCEPTANCE_PREP.md's pinned install command. Do not
  upgrade this project to WiX 7 without a deliberate, separate decision.

  STATUS: this source file is real and structurally complete for a
  single-MSI application-only install; it is NOT yet a full RC installer
  - the `ApiFiles` component group still needs real file harvesting (see
  its own comment below and scripts/windows/build-release-payload.ps1,
  which stages exactly the directory this harvest should run against),
  and the bundled-PostgreSQL components (a second service, data
  directory, role-creation custom action - see the TODOs below and
  scripts/windows/provision-postgres.ps1, whose exact logic these TODOs
  should call) are not yet added, because completing them requires the
  one genuine external artifact this whole effort has been honest about
  needing: EDB's official PostgreSQL 17 Windows binaries distribution
  (see docs/WINDOWS_INSTALLER_DESIGN.md's "Source / distribution"
  section) - not fetched by anything in this repository. Compiling this
  file itself has NOT been done in the sandbox this was authored in (no
  WiX toolchain there); it HAS been confirmed installable (WiX 4.0.6 +
  both extensions) on the real Windows 11 RC build machine - see
  docs/WINDOWS_ACCEPTANCE_PREP.md for that machine's exact verified
  toolchain state and the next real build steps.

  The API/web payload referenced below is produced by
  scripts/windows/build-release-payload.ps1 - the SAME production build
  output apps/api/Dockerfile's runtime stage packages (one build
  pipeline, two distribution mechanisms, not two separately-maintained
  builds that could drift apart). See docs/WINDOWS_INSTALLER_DESIGN.md
  for the reasoning behind every decision below.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="Hexyrn Core"
    Manufacturer="Hexyrn"
    Version="$(var.HexyrnVersion)"
    UpgradeCode="8f2b6c1a-2f0e-4c3a-9a7e-3b1c9d5f6a02"
    Compressed="yes">

    <!-- Upgrade behaviour: newer versions replace older ones in place,
         never allow a downgrade over a newer install (item 15's rollback
         strategy is handled separately, via a restored backup + an
         explicitly OLDER installer package - not by letting this MSI
         silently downgrade files under a running database). -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Hexyrn Core is already installed. Uninstall it first if you specifically need to downgrade."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Standard-ish Program Files layout, not something bespoke -
         predictable for anyone who has installed other Windows server
         software, and keeps the app payload out of user-writable
         locations by default. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Hexyrn Core">
        <!-- apps/api/dist + node_modules, i.e. the SAME output
             apps/api/Dockerfile's runtime stage packages - one build
             output, two distribution mechanisms (Docker image, Windows
             installer), not two separately-maintained builds that could
             drift apart. -->
        <Directory Id="ApiFolder" Name="api" />
        <!-- Config/data directories are OUTSIDE INSTALLFOLDER (in
             ProgramData, not Program Files) - Program Files is
             conventionally treated as read-mostly and can require
             elevated permissions to write to at runtime; a database
             connection string, license file, or backup written under
             Program Files by a running service is the kind of thing
             that silently breaks under stricter ACLs or a future
             Windows hardening policy. -->
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="HexyrnDataFolder" Name="Hexyrn Core">
        <Directory Id="HexyrnStorageFolder" Name="storage" />
        <Directory Id="HexyrnBackupsFolder" Name="backups" />
        <Directory Id="HexyrnConfigFolder" Name="config" />
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Hexyrn Core" Level="1">
      <ComponentGroupRef Id="ApiFiles" />
      <ComponentRef Id="HexyrnService" />
      <ComponentRef Id="DataDirectories" />
    </Feature>

    <!-- Windows Service registration - runs `node dist/main.js` the same
         way apps/api/Dockerfile's CMD does, just under the Windows
         Service Control Manager instead of a container's PID 1. Uses
         WiX's built-in ServiceInstall (no third-party service wrapper
         like NSSM/node-windows needed for the CORE registration - though
         one may still be worth adopting later for cleaner
         start/stop/log-rotation behaviour; a decision for the actual
         Windows-environment round, not pre-decided here).
         StartType="demand" (not "auto") is DELIBERATE for the FIRST
         release: an operator should complete first-run
         setup/configuration (see docs/OPERATOR_GUIDE.md) and confirm the
         service starts cleanly before it's set to auto-start on every
         boot - reduces the chance of a broken unattended restart loop on
         a machine an operator isn't actively watching yet. -->
    <Component Id="HexyrnService" Directory="ApiFolder" Guid="6a1d9c3e-7b4f-4a2d-8e1c-9f3a5b7d2e04">
      <File Id="ServiceMarker" Source="$(var.ApiDistPath)\main.js" KeyPath="yes" />
      <ServiceInstall
        Id="HexyrnCoreService"
        Type="ownProcess"
        Name="HexyrnCore"
        DisplayName="Hexyrn Core"
        Description="Hexyrn Core application server."
        Start="demand"
        ErrorControl="normal"
        Account="NT SERVICE\HexyrnCore" />
      <!-- Account="NT SERVICE\HexyrnCore" - a WINDOWS VIRTUAL SERVICE
           ACCOUNT (per-service SID), not LocalSystem, and not a manually
           created local/domain user Hexyrn would have to generate a
           password for and rotate. This is the genuine least-privilege
           mechanism Windows provides for exactly this case: the SCM
           creates this identity automatically the first time the
           service starts (Windows Vista/Server 2008+, universally
           available on every supported Windows edition/version this
           product targets), it cannot interactively log on, it has no
           password to manage/rotate/leak, and it gets a real, distinct
           SID that filesystem/registry ACLs can target specifically
           (`icacls ... /grant "NT SERVICE\HexyrnCore:(OI)(CI)F"` on
           %ProgramData%\Hexyrn Core\ - a genuine real Windows-round
           implementation step, not decided further in this .wxs). See
           docs/WINDOWS_INSTALLER_DESIGN.md's "Windows Service account"
           section for the full reasoning and the equivalent
           NT SERVICE\HexyrnPostgreSQL identity planned for the bundled
           PostgreSQL service below. -->
      <!-- TODO (real Windows round, once the external PostgreSQL 17
           binaries artifact is obtained - see docs/
           WINDOWS_INSTALLER_DESIGN.md's "Source / distribution" section
           and scripts/windows/provision-postgres.ps1, whose real,
           independently-verified initdb/role-creation/service-
           registration logic this TODO should call as a WiX custom
           action, not reimplement): add a second <ServiceInstall>/
           <ServiceControl> pair here for the bundled PostgreSQL service
           (Name="HexyrnPostgreSQL", Account="NT SERVICE\HexyrnPostgreSQL",
           matching this service's virtual-account pattern), installed/
           started BEFORE this service via WiX's ServiceDependencies
           element (Hexyrn Core must never race PostgreSQL during boot -
           see docs/WINDOWS_INSTALLER_DESIGN.md's "Windows services"
           section) and stopped AFTER it on shutdown. -->
      <ServiceControl
        Id="HexyrnCoreServiceControl"
        Name="HexyrnCore"
        Start="install"
        Stop="both"
        Remove="uninstall"
        Wait="yes" />
      <!-- ServiceDependencies goes here once the PostgreSQL service
           above is added: <ServiceDependency Id="HexyrnPostgreSQL" />
           inside the ServiceInstall element, so the SCM itself enforces
           start ordering rather than relying on application-level retry
           logic to paper over a race. -->
      <!-- util:ServiceConfig, NOT a core-schema element - WiX's built-in
           ServiceInstall has no failure-action attributes of its own;
           this comes from the Util extension (WixToolset.Util.wixext
           4.0.6, per this project's pinned toolchain - see this file's
           header comment), which is why the build command in
           docs/WINDOWS_ACCEPTANCE_PREP.md passes -ext
           WixToolset.Util.wixext. -->
      <util:ServiceConfig
        ServiceName="HexyrnCore"
        FirstFailureActionType="restart"
        SecondFailureActionType="restart"
        ThirdFailureActionType="none"
        RestartServiceDelayInSeconds="30"
        ResetPeriodInDays="1" />
      <!-- ServiceConfig: a crashed service auto-restarts twice with a
           real delay (not a tight crash-loop) before giving up and
           requiring operator attention - "ensure clean stop behaviour"
           and reasonable failure handling, not silent permanent downtime
           after one transient fault. -->
    </Component>

    <ComponentGroup Id="ApiFiles" Directory="ApiFolder">
      <!-- Real file harvesting (every file under the staged payload
           scripts/windows/build-release-payload.ps1 produces - dist/,
           node_modules/, packages/*/dist, apps/web/dist) is intentionally
           NOT hand-enumerated here - that belongs to a WiX harvest step
           (`wix build` with a <Files Include="..."/> heat-style glob, or
           an MSBuild-based packaging project) run against that real
           staged directory on the real Windows build machine. Real
           build command for the harvest input:
             .\scripts\windows\build-release-payload.ps1 -CleanCheckout -OutDir dist-release\payload
           then point the harvest at dist-release\payload - this script
           is genuinely tested (see its own doc comment and this repo's
           commit history for the real clean-checkout build it verified),
           not a placeholder. -->
    </ComponentGroup>

    <Component Id="DataDirectories" Directory="HexyrnDataFolder" Guid="3c7e9a1b-5d2f-4e8a-b6c3-1a9d7f2e4b08">
      <CreateFolder Directory="HexyrnStorageFolder" />
      <CreateFolder Directory="HexyrnBackupsFolder" />
      <CreateFolder Directory="HexyrnConfigFolder" />
      <!-- TODO (real Windows round): add a HexyrnPostgresDataFolder
           CreateFolder here too, per docs/WINDOWS_INSTALLER_DESIGN.md's
           now-DECIDED "Data directory" section
           (%ProgramData%\Hexyrn Core\postgresql-data\) - not added yet
           since the bundled-PostgreSQL components themselves aren't
           built here (see the ServiceInstall TODO above). -->
      <!-- Uninstall behaviour for these folders is deliberately NOT
           "always delete" - see docs/WINDOWS_INSTALLER_DESIGN.md's
           uninstall section: this mirrors scripts/uninstall-docker.sh's
           two-step confirm (remove the app, keep data - including,
           once added, the PostgreSQL data directory - unless a SEPARATE
           explicit choice says otherwise). A real WiX implementation of
           that choice needs a UI dialog sequence (a Burn bundle, not a
           bare MSI) - real Windows-round implementation work, not a
           still-open design decision (the PostgreSQL bundling question
           itself is now decided, see docs/WINDOWS_INSTALLER_DESIGN.md).
      -->
    </Component>
  </Package>
</Wix>
