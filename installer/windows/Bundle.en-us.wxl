<?xml version="1.0" encoding="UTF-8"?>
<!-- Customer-facing wording of the setup wizard (WixStandardBootstrapperApplication string overrides). -->
<WixLocalization Culture="en-us" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="ConfirmCancelMessage" Value="Are you sure you want to cancel Requisite setup? Nothing has been changed on your computer yet if you cancel now." />
  <String Id="UninstallSuccessMessage" Value="Requisite has been removed from this computer. Your business data and backups were kept in C:\ProgramData\Hexyrn Core, so installing Requisite again picks up where you left off. To erase that data too, see 'Uninstalling' in the Requisite installation guide." />
</WixLocalization>
