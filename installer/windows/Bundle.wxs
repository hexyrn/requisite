<?xml version="1.0" encoding="UTF-8"?>
<!--
  Requisite-Setup.exe - the single file a customer downloads (WiX Burn bootstrapper).

  It wraps Product.msi (the real installer) and, first, the Microsoft Visual C++ runtime that the bundled database
  engine needs on a clean Windows machine. Everything else is inside the MSI, so nothing has to be installed first.

  Why a bundle and not a bare MSI: it can install the C++ runtime in the same run, shows the licence agreement and
  branding, and offers "Launch" on the last page.

  Data safety: an ordinary uninstall NEVER removes customer data (Product.msi only removes it when the
  HEXYRNPURGEDATA property is "1", which nothing in the customer experience sets; the supported way to erase data is
  the separate Remove-RequisiteData.ps1 tool, which needs a typed confirmation).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
    Name="Requisite"
    Manufacturer="Hexyrn"
    Version="$(var.HexyrnVersion)"
    UpgradeCode="a1c9e3f5-8b2d-4e6a-9f1c-5d7b3a2e4c60"
    IconSourceFile="$(var.RepoRoot)\installer\windows\assets\requisite.ico"
    AboutUrl="$(var.SupportUrl)"
    HelpUrl="$(var.SupportUrl)"
    Copyright="Copyright (c) Hexyrn. All rights reserved.">

    <Log Prefix="Requisite-Setup" Extension=".log" />

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        Theme="rtfLicense"
        LicenseFile="$(var.RepoRoot)\installer\windows\assets\EULA.rtf"
        LogoFile="$(var.RepoRoot)\installer\windows\assets\requisite.ico"
        ShowVersion="yes"
        SuppressOptionsUI="yes"
        LaunchTarget="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
        LaunchArguments="-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[ProgramFiles64Folder]Hexyrn Core\scripts\Open-Hexyrn.ps1&quot; -Port [HEXYRNWEBPORT]"
        LaunchHidden="yes" />
    </BootstrapperApplication>

    <!-- Kept "0" (never remove data) unless someone deliberately supplies HEXYRNPURGEDATA=1 on the command line. -->
    <Variable Name="HEXYRNPURGEDATA" Type="string" Value="0" Persisted="no" />
    <!-- Web port; default 3000. IT administrators can override: Requisite-Setup.exe HEXYRNWEBPORT=8080 -->
    <Variable Name="HEXYRNWEBPORT" Type="string" Value="3000" />

    <!-- Microsoft Visual C++ 2015-2022 x64 runtime: present already on many PCs, missing on a clean Windows install. -->
    <Variable Name="VCRuntimeBld" Type="numeric" Value="0" />
    <util:RegistrySearch Id="VCRuntimeBldSearch" Variable="VCRuntimeBld" Root="HKLM"
                         Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64" Value="Bld"
                         Result="value" Bitness="always64" />

    <Chain>
      <ExePackage Id="VCRedist" Name="vc_redist.x64.exe" SourceFile="$(var.VCRedistExe)"
                  DisplayName="Microsoft Visual C++ runtime"
                  DetectCondition="VCRuntimeBld &gt;= $(var.VCRedistBuild)"
                  InstallArguments="/install /quiet /norestart"
                  RepairArguments="/repair /quiet /norestart"
                  UninstallArguments="/uninstall /quiet /norestart"
                  Permanent="yes" Vital="yes">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="1638" Behavior="success" />
        <ExitCode Value="3010" Behavior="forceReboot" />
      </ExePackage>

      <MsiPackage SourceFile="Product.msi" Vital="yes">
        <MsiProperty Name="HEXYRNPURGEDATA" Value="[HEXYRNPURGEDATA]" />
        <MsiProperty Name="HEXYRNWEBPORT" Value="[HEXYRNWEBPORT]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
