# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Postgres connection used by the API. The docker-compose "postgres" service
# (see docker-compose.yml) listens on 5432 with these exact credentials by
# default - this line matches it out of the box.
DATABASE_URL=postgres://hexyrn:hexyrn_dev_password@localhost:5432/hexyrn_core

# Used only by the test suite (docker-compose "postgres_test" service, which
# listens on 5433 to keep it fully separate from the dev database above).
#
# NOTE: if you're running a native/local Postgres install instead of Docker
# (e.g. Docker isn't available in your environment), both the dev and test
# databases typically live on the SAME native instance/port (usually 5432,
# not 5433) as separate databases (e.g. hexyrn_core / hexyrn_core_test) under
# a dedicated non-superuser `hexyrn` role - adjust the host/port/db name
# below to match your local setup accordingly. Either way, TEST_DATABASE_URL
# must point at a database distinct from DATABASE_URL, and the connecting
# role must NOT be a superuser and must NOT have BYPASSRLS, or the RLS tests
# will pass falsely (a superuser bypasses FORCE ROW LEVEL SECURITY).
TEST_DATABASE_URL=postgres://hexyrn:hexyrn_test_password@localhost:5433/hexyrn_core_test

# Session cookie signing secret - generate with: openssl rand -base64 48
SESSION_SECRET=changeme_generate_a_real_random_secret

# Master key used to envelope-encrypt TOTP secrets at rest - generate with: openssl rand -base64 32
TOTP_MASTER_KEY=changeme_generate_a_real_32_byte_key_base64

# Comma-separated list of trusted reverse-proxy IPs/CIDRs allowed to set X-Forwarded-* headers
TRUSTED_PROXY_CIDRS=

# Comma-separated list of allowed Origin/Referer values for state-changing requests
ALLOWED_ORIGINS=http://localhost:5173

# Local disk path used by the P0 stub file storage provider
LOCAL_STORAGE_PATH=./storage

# Cookie security - set to false only for local http development
COOKIE_SECURE=false
