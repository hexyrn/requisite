# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Postgres connection used by the RUNNING API AT RUNTIME (production/
# self-hosted deployments) - should be the restricted `hexyrn_app` role
# (docker-compose.yml + docker/postgres-init/01-app-role.sh create it
# automatically), never the schema-owning migration role. P3 item 18: the
# runtime role must NOT be a superuser and must NOT have BYPASSRLS, or
# FORCE ROW LEVEL SECURITY is silently defeated.
DATABASE_URL=postgres://hexyrn_app:hexyrn_app_dev_password@localhost:5432/hexyrn_core

# Postgres connection used ONLY by `npm run migrate` (apps/api/src/db/migrate.ts)
# - this is the schema-owning role that can CREATE/ALTER TABLE and
# ENABLE/FORCE ROW LEVEL SECURITY, which the runtime `hexyrn_app` role above
# deliberately cannot do. Falls back to DATABASE_URL if unset, for a
# simpler single-role setup that accepts the smaller blast-radius
# reduction (a valid choice for a small self-hosted install).
MIGRATE_DATABASE_URL=postgres://hexyrn:hexyrn_dev_password@localhost:5432/hexyrn_core

# Used by the AUTOMATED TEST SUITE (docker-compose "postgres_test" service,
# 5433). Unlike DATABASE_URL above, this MUST stay on the schema-owning
# role (e.g. `hexyrn`, not `hexyrn_app`): every integration test calls
# setUpTestDatabase()/applyMigrations() directly against this same
# connection string to drop and recreate the schema before each run, which
# requires CREATE/DROP/ALTER TABLE privilege that the restricted
# `hexyrn_app` role deliberately does not have. This is still a meaningful
# RLS test, not a false-positive risk: `hexyrn` is non-superuser and
# non-BYPASSRLS, and FORCE ROW LEVEL SECURITY (Architecture §8) applies RLS
# to the table OWNER too, not only to other roles - ownership and "subject
# to RLS" are independent properties in Postgres once FORCE is set.
# apps/api/src/db/__tests__/db-role-security.integration.spec.ts asserts
# this (non-superuser, non-BYPASSRLS, FORCE RLS present) automatically
# against whatever role this URL actually connects as, every test run.
#
# NOTE: if you're running a native/local Postgres install instead of Docker
# (e.g. Docker isn't available in your environment), both the dev and test
# databases typically live on the SAME native instance/port (usually 5432,
# not 5433) as separate databases (e.g. hexyrn_core / hexyrn_core_test)
# under a single non-superuser, non-BYPASSRLS role - adjust the host/port/
# db name below to match your local setup accordingly. Either way,
# TEST_DATABASE_URL must point at a database distinct from DATABASE_URL.
TEST_DATABASE_URL=postgres://hexyrn:hexyrn_test_password@localhost:5433/hexyrn_core_test

# Master key used to envelope-encrypt TOTP secrets at rest - generate with: openssl rand -base64 32
TOTP_MASTER_KEY=changeme_generate_a_real_32_byte_key_base64
# P2 secret-at-rest encryption (webhook signing keys, integration config
# secrets). Falls back to TOTP_MASTER_KEY if unset - set a SEPARATE key in
# production so rotating one does not force re-enrolling the other.
SECRET_ENCRYPTION_MASTER_KEY=changeme_generate_a_real_32_byte_key_base64
# P2 license verification - production MUST override the committed test key.
HEXYRN_LICENSE_PUBLIC_KEY=

# Comma-separated list of trusted reverse-proxy IPs/CIDRs allowed to set X-Forwarded-* headers
TRUSTED_PROXY_CIDRS=

# Comma-separated list of allowed Origin/Referer values for state-changing requests
ALLOWED_ORIGINS=http://localhost:5173

# Local disk path used by the P0 stub file storage provider
LOCAL_STORAGE_PATH=./storage

# Cookie security - set to false only for local http development
COOKIE_SECURE=false
