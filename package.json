{
  "name": "hexyrn-core",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace packages/shared-types --workspace packages/app-sdk --workspace packages/design-system",
    "build": "npm run build:packages && npm run build --workspace apps/api --workspace apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace apps/api",
    "migrate": "npm run migrate --workspace apps/api",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "lodash": "4.18.1"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "argon2@0.40.3": true,
    "esbuild@0.21.5": true
  }
}
